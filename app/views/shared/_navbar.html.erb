<header class="site-header">
  <nav class="site-nav" aria-label="Global">
    <%= link_to root_path, class: "brand" do %>
      <%= image_tag "icarus-wing.png", alt: "", class: "brand-mark" %>
      <span class="brand-name">iAE Grade Calculator</span>
    <% end %>
    <div class="nav-links">
      <% if user_signed_in? %>
        <%= link_to "History", surveys_path, class: "nav-link" %>
        <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link" %>
      <% else %>
        <%= link_to "Sign in", new_user_session_path, class: "nav-link" %>
        <%= link_to "Sign up", new_user_registration_path, class: "btn-primary btn-sm" %>
      <% end %>
    </div>
  </nav>
</header>
