<% { notice: "flash-notice", alert: "flash-alert" }.each do |type, css| %>
  <% if flash[type].present? %>
    <div class="flash <%= css %>" role="alert">
      <span><%= flash[type] %></span>
      <button type="button" aria-label="Dismiss" onclick="this.parentElement.remove()">&times;</button>
    </div>
  <% end %>
<% end %>
