<div class="calc-hero entry-hero">
  <h1 class="hero-title">Entry #<%= @survey.id %></h1>
  <p class="hero-sub">
    Patient ID: <strong><%= @survey.patient_id.presence || "N/A" %></strong>
    · recorded <%= @survey.created_at.strftime("%b %-d, %Y") %>
  </p>
  <div class="entry-nav">
    <%= link_to "← Calculator", root_path, class: "nav-link" %>
    <%= link_to "History", surveys_path, class: "nav-link" %>
  </div>
</div>

<%= render "results_bar", survey: @survey %>

<div class="entry-notes">
  <div class="note-card">
    <h4>iAE Description</h4>
    <p><%= @survey.iae_description.presence || "Not provided." %></p>
  </div>
  <div class="note-card">
    <h4>iAE Management</h4>
    <p><%= @survey.iae_management.presence || "Not provided." %></p>
  </div>
</div>

<% IaeGrading::SECTIONS.each do |section| %>
  <section class="question-section">
    <h2 class="section-title"><%= section[:title] %></h2>
    <ul class="question-list">
      <% section[:questions].each do |question| %>
        <li class="question-row">
          <div class="question-text"><span><%= question[:prompt] %></span></div>
          <span class="answer-chip <%= @survey[question[:key]] ? "is-yes" : "is-no" %>">
            <%= @survey.yes_or_no(@survey[question[:key]]) %>
          </span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
