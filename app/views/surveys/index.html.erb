<div class="calc-hero entry-hero">
  <h1 class="hero-title">Entry History</h1>
  <div class="entry-nav">
    <%= link_to "← Calculator", root_path, class: "nav-link" %>
    <%= link_to "Export CSV", surveys_path(format: :csv), class: "btn-primary btn-sm" %>
  </div>
</div>

<div class="history-wrap">
  <% if @surveys.any? %>
    <table class="history-table">
      <thead>
        <tr>
          <th>Entry</th>
          <th>Date</th>
          <th>Patient ID</th>
          <% IaeGrading::SCALES.each_value do |scale| %>
            <th><%= scale[:label] %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @surveys.each do |survey| %>
          <tr>
            <td><%= link_to "##{survey.id}", survey_path(survey), class: "entry-link" %></td>
            <td class="muted"><%= survey.created_at.strftime("%Y-%m-%d") %></td>
            <td><%= survey.patient_id.presence || "N/A" %></td>
            <% IaeGrading::SCALES.each_key do |key| %>
              <td>
                <span class="grade-badge" data-band="<%= grade_band(survey, key) %>">
                  <%= grade_display(survey, key) %>
                </span>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-state">No entries yet — grade an iAE on the <%= link_to "calculator", root_path %> and save it.</p>
  <% end %>
</div>
