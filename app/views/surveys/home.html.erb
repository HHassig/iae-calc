<div class="calc-hero">
  <%= image_tag "icarus-wing.png", alt: "ICARUS Project", class: "hero-mark" %>
  <h1 class="hero-title">Intraoperative Adverse Event (iAE) Grade Calculator</h1>
  <p class="hero-sub">
    Answer the questions below — the event is graded live across the five published
    iAE classification systems.
  </p>
</div>

<div data-controller="calculator" class="calculator">
  <%= render "results_bar", survey: nil %>

  <%= form_with model: @survey, url: surveys_path,
                data: { calculator_target: "form", action: "change->calculator#changed", turbo: false } do |f| %>
    <% IaeGrading::SECTIONS.each do |section| %>
      <section class="question-section">
        <h2 class="section-title"><%= section[:title] %></h2>
        <ul class="question-list">
          <%= render partial: "question", collection: section[:questions], locals: { f: f } %>
        </ul>
      </section>
    <% end %>

    <section class="question-section">
      <h2 class="section-title">Entry Details <span class="section-hint">optional</span></h2>
      <div class="details-card">
        <div class="detail-field">
          <%= f.label :patient_id, "Patient ID" %>
          <%= f.text_field :patient_id, autocomplete: "off" %>
        </div>
        <div class="detail-field">
          <%= f.label :iae_description, "iAE Description" %>
          <%= f.text_area :iae_description, rows: 2 %>
        </div>
        <div class="detail-field">
          <%= f.label :iae_management, "iAE Management" %>
          <%= f.text_area :iae_management, rows: 2 %>
        </div>
      </div>
    </section>

    <div class="submit-survey">
      <% if user_signed_in? %>
        <%= f.submit "Save entry", class: "btn-primary" %>
      <% else %>
        <%= link_to "Sign in to save this entry", new_user_session_path, class: "btn-primary" %>
        <p class="submit-hint">The calculator itself works without an account.</p>
      <% end %>
    </div>
  <% end %>
</div>
