<div class="flex flex-col justify-center px-6 py-4 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-sm">
    <h2 class="mt-4 text-center text-2xl font-bold leading-9 tracking-tight text-gray-900">Sign in to your account</h2>
  </div>

  <div class="mt-4 sm:mx-auto sm:w-full sm:max-w-sm">
    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-inputs">
        <%= f.input :email,
                    required: true,
                    autofocus: true,
                    input_html: { autocomplete: "email" } %>
        <%= f.input :password,
                    required: true,
                    input_html: { autocomplete: "current-password" } %>
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
      </div>
      <div class="form-actions mt-4">
        <%= f.button :submit, "Sign in", class: "btn-primary w-full" %>
      </div>
    <% end %>
    <p class="mt-4 text-center text-sm text-gray-500">
      No account yet?
      <%= link_to "Sign up", new_user_registration_path, class: "font-semibold" %>
      ·
      <%= link_to "Forgot password?", new_user_password_path, class: "font-semibold" %>
    </p>
  </div>
</div>
